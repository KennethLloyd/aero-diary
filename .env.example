# Aero Diary environment template
#
# Copy to `.env.local` for Mac dev, `.env` on the OCI box for production.
# Never commit real values — the repo .gitignore protects env files.
# Every var is read server-side only; there are no NEXT_PUBLIC_* vars by
# design (secrets never reach the client).

# ── Database (ADR-0001) ────────────────────────────────────────────────
# Prisma 7 + SQLite via driver adapter. Path is relative to prisma.config.ts.
# Create the data/ directory first (SQLite creates the file, not the folder).
DATABASE_URL="file:./data/aero-diary.db"

# ── Auth (ADR-0002, ticket #2) ─────────────────────────────────────────
# NOT USED by the current design. Sessions are opaque DB-backed tokens
# (ADR-0002): the cookie holds a raw 256-bit random token, the DB stores only
# its SHA-256 hash, and the DB row is the authority — so no signing secret is
# needed. This var is reserved for a future switch to signed (jose) cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Google Drive photos (ADR-0003, ticket #6) ──────────────────────────
# OAuth desktop-app client (reuse the rclone-backup GCP project or a
# dedicated "aero-diary" client). The refresh token is minted once via the
# local loopback flow; scope: https://www.googleapis.com/auth/drive
# Bootstrap once with: pnpm drive:bootstrap
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Canonical photo folder under Drive; legacy photoPaths (`photos/<hash>.jpg`)
# map 1:1 beneath it.
GOOGLE_DRIVE_PHOTOS_ROOT="AeroDiary/photos"

# ── Journal polish (ADR-0005, ticket #7) ────────────────────────────────
# OpenAI-compatible endpoint. ChatMock serves this contract locally after
# `chatmock login` and `chatmock serve`.
LLM_BASE_URL="http://127.0.0.1:8000"
LLM_MODEL="gpt-5.6-luna"
# Reasoning effort and output cap are passed through to the configured endpoint.
LLM_REASONING_EFFORT="medium"
LLM_MAX_TOKENS="16384"
LLM_TIMEOUT_MS="30000"

# Seed each user's private style standard into User.styleStandard with:
# `pnpm seed-style-standard <email> <private-style-file>`.

# ── Optional ────────────────────────────────────────────────────────────
# APP_URL=http://localhost:3000   # absolute URLs if ever needed
