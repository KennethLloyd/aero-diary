# Aero Diary environment template
#
# Copy to `.env.local` for local development or to the environment used to run
# the application.
# Never commit real values — the repo .gitignore protects env files.
# Every var is read server-side only; there are no NEXT_PUBLIC_* vars by
# design (secrets never reach the client).

# ── Database ───────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension. Local Docker setup is in compose.yaml.
DATABASE_URL="postgresql://aero:aero-local-only@127.0.0.1:5432/aero_diary"

# Local Ollama embedding service. The model is embeddinggemma:300m-qat-q4_0.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBEDDING_TIMEOUT_MS="120000"

# ── Configured demo account ────────────────────────────────────────────
# `pnpm db:seed` provisions this as an ordinary User and refreshes only its
# deterministic, user-scoped demo entries, activities, and photo metadata.
# Use a dedicated account email; never point this at a real user's email.
DEMO_EMAIL=
DEMO_PASSWORD=

# ── Google Drive photos ────────────────────────────────────────────────
# OAuth desktop-app client. The refresh token is minted once via the
# local loopback flow; scope: https://www.googleapis.com/auth/drive
# Bootstrap once with: pnpm drive:bootstrap
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Canonical photo folder under Drive.
GOOGLE_DRIVE_PHOTOS_ROOT="AeroDiary/photos"

# ── Journal polish ─────────────────────────────────────────────────────
# OpenAI-compatible base URL supplied by the environment.
LLM_BASE_URL=
LLM_MODEL=
# Reasoning effort and output cap are passed through to the configured endpoint.
LLM_REASONING_EFFORT="medium"
LLM_MAX_TOKENS="16384"
LLM_TIMEOUT_MS="30000"
