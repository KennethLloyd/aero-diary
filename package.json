{
  "name": "aero-diary",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted mood journal in the Frutiger Aero aesthetic.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "create-user": "tsx scripts/create-user.ts",
    "db:seed": "tsx scripts/seed.ts",
    "drive:bootstrap": "tsx scripts/bootstrap-google-drive.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:setup": "pnpm run db:migrate:deploy && pnpm run memory:queue:setup",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts",
    "db:studio": "prisma studio",
    "memory:queue:setup": "tsx scripts/journal-memory-queue.ts",
    "memory:worker": "tsx scripts/journal-memory-worker.ts",
    "memory:backfill": "tsx scripts/journal-memory-backfill.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "2.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@swc/helpers": "0.5.23",
    "googleapis": "176.0.0",
    "heic-convert": "2.1.0",
    "next": "16.3.1",
    "node-emoji": "2.2.0",
    "pg-boss": "12.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "30.0.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
