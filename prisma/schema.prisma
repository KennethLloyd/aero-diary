// Aero Diary data model.
// Prisma reads the datasource URL from prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Mood {
  AWFUL
  BAD
  MEH
  GOOD
  RAD
}

enum ActivityInferenceStatus {
  PENDING
  COMPLETE
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  styleStandard String? // optional per-user polish rules; blank uses the concise default
  sessions      Session[]
  entries       Entry[]
  activities    Activity[]
  stagedPhotos        StagedPhoto[]
  stagedCancellations StagedPhotoCancellation[]
  createdAt     DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 of the opaque session token
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Entry {
  id          String    @id @default(cuid())
  sourceId    Int?      @unique // optional external key retained for existing data
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalDate String    // canonical YYYY-MM-DD journal placement
  mood        Mood
  note        String
  activityInferenceStatus ActivityInferenceStatus @default(COMPLETE)
  isFavorite  Boolean   @default(false)
  activities  EntryActivity[]
  photos      Photo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, journalDate])
}

model Activity {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  emoji      String          @default("✨")
  isArchived Boolean         @default(false)
  entries    EntryActivity[]
  sortOrder  Int             @default(0)
  @@unique([userId, name, emoji])
}

model EntryActivity {
  entryId    String
  activityId String
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  @@id([entryId, activityId])
}
model Photo {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  drivePath String // e.g. "photos/<md5>.jpg" — relative to the AeroDiary Drive folder
  driveFileId String? // Drive file id for unambiguous new-upload reads/deletes
  mimeType  String
  sizeBytes Int?
  createdAt DateTime @default(now())
}

model StagedPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftKey    String
  clientKey   String
  drivePath   String
  driveFileId String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@unique([userId, draftKey, clientKey])
  @@index([userId, draftKey, createdAt])
}

model StagedPhotoCancellation {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftKey  String
  clientKey String
  stagedPhotoId String?  @unique
  createdAt     DateTime @default(now())
  expired       Boolean  @default(false)

  @@id([userId, draftKey, clientKey])
  @@index([createdAt])
}
